# demo is deterministic rules, not a language model. Set ollama for real inference.
KNOWGPT_LLM_PROVIDER=demo
KNOWGPT_LLM_URL=http://localhost:11434
KNOWGPT_LLM_MODEL=qwen2.5:7b
KNOWGPT_API_KEY=
# sentence_transformer enables local BGE + FAISS; hash is offline demo retrieval.
KNOWGPT_EMBEDDING_PROVIDER=hash
KNOWGPT_ASR_MODEL=small
KNOWGPT_ASR_DEVICE=cpu
# Optional per-role overrides (native mode; YAML configs/default.yaml works in Docker too).
# KNOWGPT_AGENTS__REVIEWER__MODEL=qwen2.5:7b
# KNOWGPT_AGENTS__REVIEWER__PROVIDER=ollama
# KNOWGPT_AGENTS__REVIEWER__URL=http://localhost:11434
# KNOWGPT_AGENTS__MAX_REVISIONS=2
# KNOWGPT_AGENTS__MAX_MODEL_CALLS=9
